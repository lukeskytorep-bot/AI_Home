{
  "contractVersion": 1,
  "commands": {
    "memory.record.create": {
      "scope": "profile",
      "payload": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "episodic",
              "relationship",
              "longTerm",
              "intent",
              "workRule"
            ]
          },
          "annotations": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "intent": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "open",
                      "completed",
                      "expired",
                      "abandoned"
                    ]
                  },
                  "trigger": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "enum": [
                          "manual",
                          "time",
                          "event"
                        ]
                      },
                      "value": {
                        "type": "string",
                        "maxLength": 512
                      }
                    },
                    "required": [
                      "kind",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  "importance": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "expiresAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "status",
                  "trigger",
                  "importance"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "title"
            ],
            "additionalProperties": false
          },
          "subjectRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "kind",
          "annotations"
        ],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "record": {
            "$ref": "#/$defs/MemoryRecord"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 128
              },
              "addedBy": {
                "const": "human"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              },
              "intent": {
                "$ref": "#/$defs/Intent"
              }
            },
            "required": [
              "title",
              "addedBy",
              "createdAt",
              "updatedAt"
            ],
            "additionalProperties": false
          },
          "version": {
            "$ref": "#/$defs/MemoryVersion"
          },
          "versionMetadata": {
            "type": "object",
            "properties": {
              "annotations": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "addedBy": {
                    "const": "human"
                  },
                  "createdAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "updatedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "intent": {
                    "$ref": "#/$defs/Intent"
                  }
                },
                "required": [
                  "title",
                  "addedBy",
                  "createdAt",
                  "updatedAt"
                ],
                "additionalProperties": false
              },
              "correctionReason": {
                "type": "string",
                "maxLength": 1024
              },
              "previousVersionId": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  {
                    "const": null
                  }
                ]
              },
              "restoredFromVersionId": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  {
                    "const": null
                  }
                ]
              },
              "sourceContacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "messageId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "conversationId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "role": {
                      "enum": [
                        "human",
                        "assistant"
                      ]
                    },
                    "language": {
                      "type": "string"
                    },
                    "sequence": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "messageId",
                    "conversationId",
                    "createdAt",
                    "role",
                    "language",
                    "sequence"
                  ],
                  "additionalProperties": false
                }
              },
              "lastContactAt": {
                "oneOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "const": null
                  }
                ]
              },
              "committedAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "annotations",
              "correctionReason",
              "previousVersionId",
              "restoredFromVersionId",
              "sourceContacts",
              "lastContactAt",
              "committedAt"
            ],
            "additionalProperties": false
          },
          "effectiveIntentStatus": {
            "enum": [
              "open",
              "completed",
              "expired",
              "abandoned"
            ]
          }
        },
        "required": [
          "record",
          "metadata"
        ],
        "additionalProperties": false
      },
      "mutates": true,
      "requiresExpectedRevision": false,
      "async": false
    },
