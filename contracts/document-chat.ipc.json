{
  "contractVersion": 1,
  "note": "Read-only preflight; chat.send repeats the same preparation atomically before accepting. Does not reserve budget or send HTTP. Frozen P2 unchanged.",
  "commands": {
    "chat.preflight": {
      "scope": "profile",
      "payload": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "attachmentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "required": [
          "conversationId",
          "content",
          "language",
          "attachmentIds"
        ],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "modelRouteRevision": {
            "type": "integer",
            "minimum": 0
          },
          "estimatedInputTokens": {
            "type": "integer",
            "minimum": 0
          },
          "outputTokens": {
            "type": "integer",
            "minimum": 0
          },
          "inputReserveTokens": {
            "type": "integer",
            "minimum": 0
          },
          "contextTokens": {
            "type": "integer",
            "minimum": 0
          },
          "attachmentCount": {
            "type": "integer",
            "minimum": 0
          },
          "modelRouteId": {
            "type": "string",
            "minLength": 1
          },
          "measurement": {
            "enum": [
              "utf8_bytes_estimate",
              "utf8_bytes_and_image_reserve_estimate"
            ]
          },
          "imageCount": {
            "type": "integer",
            "minimum": 0
          },
          "imageInputTokens": {
            "type": "integer",
            "minimum": 0
          },
          "visionPolicyRevision": {
            "type": "integer",
            "minimum": 0
          },
          "workingContext": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "included": {
                    "const": false
                  },
                  "recordId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "recordRevision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "state": {
                    "enum": [
                      "empty",
                      "outdated",
                      "archived"
                    ]
                  }
                },
                "required": [
                  "included",
                  "recordId",
                  "recordRevision",
                  "state"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "included": {
                    "const": true
                  },
                  "recordId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "recordRevision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "state": {
                    "const": "active"
                  },
                  "versionId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "versionNumber": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "contentSha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "language": {
                    "type": "string",
                    "minLength": 1
                  },
                  "decisionReceiptId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "measurement": {
                    "$ref": "#/$defs/TokenMeasurement"
                  },
                  "inputTokens": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "included",
                  "recordId",
                  "recordRevision",
                  "state",
                  "versionId",
                  "versionNumber",
                  "contentSha256",
                  "language",
                  "decisionReceiptId",
                  "measurement",
                  "inputTokens"
                ],
                "additionalProperties": false
              }
            ]
          },
          "retrieval": {
            "type": "object",
            "properties": {
              "method": {
                "const": "lexical_unicode_terms_v1"
              },
              "query": {
                "type": "string",
                "maxLength": 4096
              },
              "queryWindow": {
                "const": "last_4096_characters"
              },
              "budgetTokens": {
                "type": "integer",
                "minimum": 0
              },
              "inputTokens": {
                "type": "integer",
                "minimum": 0
              },
              "matchedCount": {
                "type": "integer",
                "minimum": 0
              },
              "omittedCount": {
                "type": "integer",
                "minimum": 0
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "record": {
                      "$ref": "#/$defs/MemoryRecord"
                    },
                    "version": {
                      "$ref": "#/$defs/MemoryVersion"
                    },
                    "decision": {
                      "$ref": "#/$defs/MemoryDecisionReceipt"
                    },
                    "metadata": {
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string",
                          "maxLength": 128
                        },
                        "addedBy": {
                          "const": "human"
                        },
                        "createdAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "updatedAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "intent": {
                          "$ref": "#/$defs/Intent"
                        }
                      },
                      "required": [
                        "title",
                        "addedBy",
                        "createdAt",
                        "updatedAt"
                      ],
                      "additionalProperties": false
                    },
                    "score": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "inputTokens": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "measurement": {
                      "$ref": "#/$defs/TokenMeasurement"
                    }
                  },
                  "required": [
                    "record",
                    "version",
                    "decision",
                    "metadata",
                    "score",
                    "inputTokens",
                    "measurement"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "method",
              "query",
              "queryWindow",
              "budgetTokens",
              "inputTokens",
              "matchedCount",
              "omittedCount",
              "items"
            ],
            "additionalProperties": false
          },
          "knowledge": {
            "type": "object"
          },
          "guidance": {
            "type": "object"
          },
          "segmentContext": {
            "type": "object"
          }
        },
        "required": [
          "modelRouteRevision",
          "estimatedInputTokens",
          "outputTokens",
          "inputReserveTokens",
          "contextTokens",
          "attachmentCount",
          "modelRouteId",
          "measurement",
          "workingContext",
          "segmentContext"
        ],
        "additionalProperties": false
      },
      "firstImplementationStage": "4B-2",
      "mutates": false,
      "requiresExpectedRevision": true,
      "async": false
    }
  }
}
