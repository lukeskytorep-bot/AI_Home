{
  "contractVersion": 1,
  "note": "Read-only preflight; chat.send repeats the same preparation atomically before accepting. Does not reserve budget or send HTTP. Frozen P2 unchanged.",
  "commands": {
    "chat.preflight": {
      "scope": "profile",
      "payload": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "attachmentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "required": [
          "conversationId",
          "content",
          "language",
          "attachmentIds"
        ],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "modelRouteRevision": {
            "type": "integer",
            "minimum": 0
          },
          "estimatedInputTokens": {
            "type": "integer",
            "minimum": 0
          },
          "outputTokens": {
            "type": "integer",
            "minimum": 0
          },
          "inputReserveTokens": {
            "type": "integer",
            "minimum": 0
          },
          "contextTokens": {
            "type": "integer",
            "minimum": 0
          },
          "attachmentCount": {
            "type": "integer",
            "minimum": 0
          },
          "modelRouteId": {
            "type": "string",
            "minLength": 1
          },
          "measurement": {
            "enum": [
              "utf8_bytes_estimate",
              "utf8_bytes_and_image_reserve_estimate"
            ]
          },
          "imageCount": {
            "type": "integer",
            "minimum": 0
          },
          "imageInputTokens": {
            "type": "integer",
            "minimum": 0
          },
          "visionPolicyRevision": {
            "type": "integer",
            "minimum": 0
          },
          "workingContext": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "included": {
                    "const": false
                  },
                  "recordId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "recordRevision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "state": {
                    "enum": [
                      "empty",
                      "outdated",
                      "archived"
                    ]
                  }
                },
                "required": [
                  "included",
                  "recordId",
                  "recordRevision",
                  "state"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "included": {
                    "const": true
                  },
                  "recordId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "recordRevision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "state": {
                    "const": "active"
                  },
                  "versionId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "versionNumber": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "contentSha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "language": {
                    "type": "string",
                    "minLength": 1
                  },
                  "decisionReceiptId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "measurement": {
                    "$ref": "#/$defs/TokenMeasurement"
                  },
                  "inputTokens": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "included",
                  "recordId",
                  "recordRevision",
                  "state",
                  "versionId",
                  "versionNumber",
                  "contentSha256",
                  "language",
                  "decisionReceiptId",
                  "measurement",
                  "inputTokens"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "modelRouteRevision",
          "estimatedInputTokens",
          "outputTokens",
          "inputReserveTokens",
          "contextTokens",
          "attachmentCount",
          "modelRouteId",
          "measurement",
          "workingContext"
        ],
        "additionalProperties": false
      },
      "firstImplementationStage": "4B-2",
      "mutates": false,
      "requiresExpectedRevision": true,
      "async": false
    }
  }
}
