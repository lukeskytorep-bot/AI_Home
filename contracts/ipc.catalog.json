    "COST_ESTIMATE_UNKNOWN",
    "OPERATION_BUDGET_EXCEEDED",
    "OPERATION_CANCELLED",
    "OPERATION_INTERRUPTED",
    "PROVIDER_ERROR",
    "POLICY_DENIED",
