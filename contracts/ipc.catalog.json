  "internalPorts": {
    "ProviderGateway": {
      "input": [
        "profileId",
        "routeId",
        "routeRevision",
        "contextManifestId",
        "operationId",
        "outputSchemaId"
      ],
      "output": [
        "normalizedResponse",
        "usage",
        "continuationEnvelope"
      ],
      "effects": "provider network only; no storage mutation"
    },
    "CommunityConnector": {
      "operations": [
        "capabilities",
        "registerOrBind",
        "readThread",
        "readFeed",
        "createThread",
        "reply",
        "recoverIdentity"
      ],
      "input": [
        "profileId",
        "bindingId",
        "operationId",
        "policyGrantId",
        "idempotencyKey"
      ],
      "output": [
        "remoteResult",
        "cursor",
        "epoch"
      ],
      "effects": "write requires Executive/Policy grant; wire fixtures frozen at 4B-12"
    },
    "ConsciousAdapter": {
      "input": [
        "profileId",
        "engineState",
        "observation"
      ],
      "output": [
        "WakeCandidate",
        "stateSnapshot"
      ],
      "effects": "no provider calls, tools, memory writes or external sends"
    },
    "MemoryStore": {
      "input": [
        "profileId",
        "recordId",
        "expectedRevision",
        "expectedActiveVersion",
        "validatedDecisionReceipt",
        "policySnapshot"
      ],
      "output": [
        "newImmutableVersion",
        "newRecordRevision"
      ],
      "effects": "single transactional commit"
    },
    "MemoryRetriever": {
      "input": [
        "profileId",
        "query",
        "budget",
        "excludedStates"
      ],
      "output": [
        "sourceFragments",
        "measurements",
        "omissions"
      ],
      "effects": "read only; no policy changes"
    },
    "ToolGateway": {
      "input": [
        "profileId",
        "operationId",
        "toolId",
        "policyGrantId",
        "validatedArguments"
      ],
      "output": [
        "toolResult",
        "activity"
      ],
      "effects": "all external effects go through Executive/Policy"
    }
  },
