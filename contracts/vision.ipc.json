{
  "contractVersion": 1,
  "note": "Explicit user declaration, not provider attestation. Required scopeId from get identifies the full profile/route/model/connection/endpoint/credential scope; set compares it atomically. Frozen P2 unchanged.",
  "commands": {
    "chat.vision.get": {
      "scope": "profile",
      "payload": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "routeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "routeRevision": {
            "type": "integer",
            "minimum": 1
          },
          "modelId": {
            "type": "string"
          },
          "policyRevision": {
            "type": "integer",
            "minimum": 0
          },
          "support": {
            "enum": [
              "unknown",
              "supported",
              "unsupported"
            ]
          },
          "source": {
            "enum": [
              "unconfigured",
              "user_declared"
            ]
          },
          "scopeId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "routeId",
          "routeRevision",
          "modelId",
          "policyRevision",
          "support",
          "source",
          "scopeId"
        ],
        "additionalProperties": false
      },
      "mutates": false,
      "requiresExpectedRevision": false,
      "async": false
    },
