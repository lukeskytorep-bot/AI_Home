{
  "contractVersion": 1,
  "commands": {
    "conversation.get": {
      "scope": "profile",
      "payload": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "conversationId"
        ],
        "additionalProperties": false
      },
      "result": {
        "$ref": "#/$defs/Conversation"
      },
      "mutates": false,
      "requiresExpectedRevision": false,
      "async": false,
      "firstImplementationStage": "4B-2"
    },
    "conversation.list": {
      "scope": "profile",
      "payload": {
        "type": "object",
        "properties": {
          "page": {
            "$ref": "#/$defs/PageRequest"
          }
        },
        "required": [
          "page"
        ],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Conversation"
            }
          },
          "nextCursor": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "mutates": false,
      "requiresExpectedRevision": false,
      "async": false,
      "firstImplementationStage": "4B-2"
    }
  }
}
