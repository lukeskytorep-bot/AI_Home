      "properties": {
        "sourceKind": {
          "type": "string",
          "enum": [
            "conversation",
            "message",
            "memory",
            "import",
            "tool_result",
            "event",
            "action",
            "note",
            "other"
          ]
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "availability": {
          "type": "string",
          "enum": [
            "available",
            "permanently_deleted",
            "unavailable"
          ]
        }
      },
      "required": [
        "sourceKind",
        "sourceId",
        "sourceRevision",
        "sha256",
        "availability"
      ],
      "additionalProperties": false
    },
