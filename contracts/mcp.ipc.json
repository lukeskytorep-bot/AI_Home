{
  "contractVersion": 1,
  "scope": "mcp_client",
  "commands": {
    "mcp.server.list": {
      "mutates": false,
      "payload": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "profileId": {"type": "string", "minLength": 1},
          "items": {"type": "array"}
        },
        "required": ["profileId", "items"],
        "additionalProperties": false
      }
    },
    "mcp.server.save": {
      "mutates": true,
      "payload": {
        "type": "object",
        "properties": {
          "serverId": {"type": "string", "minLength": 1, "maxLength": 128},
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "endpoint": {"type": "string", "minLength": 1, "maxLength": 1024},
          "apiKey": {"type": "string", "minLength": 1, "maxLength": 8192},
          "allowMutating": {"type": "boolean"},
          "allowedTools": {
            "type": "array",
            "maxItems": 128,
            "items": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "enabled": {"type": "boolean"},
          "reconcileReceiptRef": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "required": ["name", "endpoint"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "profileId": {"type": "string", "minLength": 1},
          "server": {"type": "object"}
        },
        "required": ["profileId", "server"],
        "additionalProperties": false
      }
    },
    "mcp.server.delete": {
      "mutates": true,
      "payload": {
        "type": "object",
        "properties": {
          "serverId": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "required": ["serverId"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "profileId": {"type": "string", "minLength": 1},
          "serverId": {"type": "string", "minLength": 1},
          "deleted": {"type": "boolean"}
        },
        "required": ["profileId", "serverId", "deleted"],
        "additionalProperties": false
      }
    },
    "mcp.server.discover": {
      "mutates": true,
      "payload": {
        "type": "object",
        "properties": {
          "serverId": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "required": ["serverId"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "profileId": {"type": "string", "minLength": 1},
          "server": {"type": "object"},
          "capabilities": {"type": "object"},
          "tools": {"type": "array"}
        },
        "required": ["profileId", "server", "capabilities", "tools"],
        "additionalProperties": false
      }
    },
    "mcp.tool.call": {
      "mutates": true,
      "payload": {
        "type": "object",
        "properties": {
          "serverId": {"type": "string", "minLength": 1, "maxLength": 128},
          "toolName": {"type": "string", "minLength": 1, "maxLength": 128},
          "arguments": {"type": "object"},
          "mutating": {"type": "boolean"},
          "sourceTags": {
            "type": "array",
            "maxItems": 32,
            "items": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        },
        "required": ["serverId", "toolName"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "profileId": {"type": "string", "minLength": 1},
          "serverId": {"type": "string", "minLength": 1},
          "toolName": {"type": "string", "minLength": 1},
          "status": {"enum": ["succeeded", "tool_failed", "policy_denied", "uncertain"]},
          "content": {},
          "receiptRef": {"type": "string"},
          "reason": {"type": "string"}
        },
        "required": ["profileId", "serverId", "toolName", "status"],
        "additionalProperties": false
      }
    }
  }
}
