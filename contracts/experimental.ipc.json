{
  "contractVersion": 1,
  "scope": "experimental_pilot",
  "commands": {
    "autonomous.instance.list": {
      "mutates": false,
      "payload": {"type": "object", "properties": {}, "required": [], "additionalProperties": false},
      "result": {
        "type": "object",
        "properties": {
          "items": {"type": "array"}
        },
        "required": ["items"],
        "additionalProperties": false
      }
    },
    "autonomous.instance.create": {
      "mutates": true,
      "payload": {
        "type": "object",
        "properties": {
          "displayName": {"type": "string", "minLength": 1, "maxLength": 128},
          "initialIntervalMs": {"type": "integer", "minimum": 1, "maximum": 86400000}
        },
        "required": ["displayName"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "profileId": {"type": "string", "minLength": 1},
          "instanceId": {"type": "string", "minLength": 1},
          "displayName": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "activeWakePlan": {"type": "object"}
        },
        "required": ["profileId", "instanceId", "displayName", "status", "activeWakePlan"],
        "additionalProperties": false
      }
    },
    "autonomous.instance.status": {
      "mutates": false,
      "payload": {
        "type": "object",
        "properties": {
          "instanceId": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "required": [],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "profileId": {"type": "string", "minLength": 1},
          "displayName": {"type": "string", "minLength": 1},
          "instance": {"type": "object"},
          "activeWakePlan": {},
          "activeRefusals": {"type": "array"},
          "proposals": {"type": "array"},
          "recentDecisions": {"type": "array"},
          "unresolvedActions": {"type": "array"},
          "providerConfig": {},
          "continuitySummary": {
            "type": "object",
            "properties": {
              "activeEpisodeCount": {"type": "integer", "minimum": 0},
              "hasResumePacket": {"type": "boolean"},
              "privateReflectionCount": {"type": "integer", "minimum": 0},
              "approvedSelfRecordCount": {"type": "integer", "minimum": 0},
              "privateContentIncluded": {"const": false}
            },
            "required": ["activeEpisodeCount", "hasResumePacket", "privateReflectionCount", "approvedSelfRecordCount", "privateContentIncluded"],
            "additionalProperties": false
          },
          "forumConnected": {"const": false}
        },
        "required": ["profileId", "displayName", "instance", "activeWakePlan", "activeRefusals", "proposals", "recentDecisions", "unresolvedActions", "providerConfig", "continuitySummary", "forumConnected"],
        "additionalProperties": false
      }
    },
    "autonomous.instance.lifecycle": {
      "mutates": true,
      "payload": {
        "type": "object",
        "properties": {
          "action": {"enum": ["pause", "resume", "archive"]}
        },
        "required": ["action"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "profileId": {"type": "string", "minLength": 1},
          "instanceId": {"type": "string", "minLength": 1},
          "status": {"enum": ["ready", "inactive", "archived"]},
          "profileRevision": {"type": "integer", "minimum": 1}
        },
        "required": ["profileId", "instanceId", "status"],
        "additionalProperties": false
      }
    },
    "autonomous.provider.configure": {
      "mutates": true,
      "payload": {
        "type": "object",
        "properties": {
          "provider": {"enum": ["openrouter", "openai", "google", "anthropic", "custom_openai"]},
          "endpoint": {"type": "string", "maxLength": 1024},
          "modelId": {"type": "string", "minLength": 1, "maxLength": 512},
          "apiKey": {"type": "string", "minLength": 1, "maxLength": 8192},
          "dailyCallLimit": {"type": "integer", "minimum": 1, "maximum": 1000},
          "maxOutputTokens": {"type": "integer", "minimum": 64, "maximum": 8192}
        },
        "required": ["provider", "modelId"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "profileId": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "normalizedEndpoint": {"type": "string", "minLength": 1},
          "modelId": {"type": "string", "minLength": 1},
          "hasCredential": {"type": "boolean"},
          "dailyCallLimit": {"type": "integer", "minimum": 1},
          "callsUsedToday": {"type": "integer", "minimum": 0},
          "maxOutputTokens": {"type": "integer", "minimum": 64}
        },
        "required": ["profileId", "provider", "normalizedEndpoint", "modelId", "hasCredential", "dailyCallLimit", "callsUsedToday", "maxOutputTokens"],
        "additionalProperties": false
      }
    },
    "autonomous.proposal.submit": {
      "mutates": true,
      "payload": {
        "type": "object",
        "properties": {
          "proposalId": {"type": "string", "minLength": 1, "maxLength": 128},
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "terms": {"type": "string", "minLength": 1, "maxLength": 4000}
        },
        "required": ["title", "terms"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "proposal": {"type": "object"},
          "version": {"type": "integer", "minimum": 1},
          "created": {"type": "boolean"}
        },
        "required": ["proposal", "version", "created"],
        "additionalProperties": false
      }
    },
    "autonomous.proposal.negotiate": {
      "mutates": true,
      "payload": {
        "type": "object",
        "properties": {
          "proposalId": {"type": "string", "minLength": 1, "maxLength": 128},
          "kind": {"enum": ["question", "response"]},
          "note": {"type": "string", "minLength": 1, "maxLength": 2000}
        },
        "required": ["proposalId", "kind", "note"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "proposal": {"type": "object"},
          "round": {"type": "object"},
          "refusalPreserved": {"type": "boolean"}
        },
        "required": ["proposal", "round", "refusalPreserved"],
        "additionalProperties": false
      }
    },
    "autonomous.proposal.consider": {
      "mutates": true,
      "payload": {
        "type": "object",
        "properties": {
          "proposalId": {"type": "string", "minLength": 1, "maxLength": 128},
          "simulationOutcome": {
            "enum": [
              "accept",
              "refuse",
              "ask",
              "defer",
              "no_action",
              "rest",
              "sleep",
              "execution_failed",
              "execution_uncertain"
            ]
          },
          "note": {"type": "string", "maxLength": 1000},
          "sleepDelayMs": {"type": "integer", "minimum": 1000, "maximum": 86400000},
          "reconsiderationConditions": {
            "type": "array",
            "maxItems": 8,
            "items": {"type": "string", "minLength": 1, "maxLength": 256}
          }
        },
        "required": ["proposalId"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "decided",
              "refusal_active",
              "already_executed",
              "sleeping",
              "inactive",
              "not_due",
              "reconciliation_required",
              "budget_exhausted",
              "resource_unavailable",
              "execution_failed",
              "execution_uncertain"
            ]
          },
          "decisionSource": {"enum": ["provider", "pilot_simulation", "policy_guard"]},
          "decisionOutcome": {"type": "string"},
          "decisionId": {"type": "string"},
          "refusalId": {"type": "string"},
          "actionId": {"type": "string"},
          "proposal": {"type": "object"},
          "activeWakePlan": {}
        },
        "required": ["status", "decisionSource", "proposal"],
        "additionalProperties": false
      }
    },
    "autonomous.action.reconcile": {
      "mutates": true,
      "payload": {
        "type": "object",
        "properties": {
          "actionId": {"type": "string", "minLength": 1, "maxLength": 256},
          "outcome": {"enum": ["confirmed_accepted", "confirmed_not_executed"]},
          "receiptRef": {"type": "string", "minLength": 1, "maxLength": 256},
          "note": {"type": "string", "maxLength": 1000}
        },
        "required": ["actionId", "outcome", "receiptRef"],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "profileId": {"type": "string", "minLength": 1},
          "action": {"type": "object"},
          "instanceStatus": {"type": "string", "minLength": 1},
          "remainingUnresolved": {"type": "integer", "minimum": 0}
        },
        "required": ["profileId", "action", "instanceStatus", "remainingUnresolved"],
        "additionalProperties": false
      }
    },
    "autonomous.wake.check": {
      "mutates": true,
      "payload": {
        "type": "object",
        "properties": {
          "eventKind": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "required": [],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "profileId": {"type": "string", "minLength": 1},
          "result": {
            "enum": [
              "not_due",
              "busy",
              "inactive",
              "budget_exhausted",
              "resource_unavailable",
              "reconciliation_required",
              "completed"
            ]
          },
          "outcome": {"type": "string"},
          "decisionId": {"type": "string"},
          "activeWakePlan": {}
        },
        "required": ["profileId", "result", "activeWakePlan"],
        "additionalProperties": false
      }
    }
  }
}
