{
  "name": "ai-home",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "verify:rust-source-text": "python3 scripts/verify-rust-source-text.py",
    "verify:command-parity": "python3 scripts/verify-command-parity.py",
    "verify:standard": "python3 scripts/verify-standard-closure.py",
    "verify:standard-release": "python3 scripts/verify-standard-release.py",
    "verify:experimental-foundation": "python3 scripts/verify-experimental-foundation.py",
    "verify:experimental-runtime": "python3 scripts/verify-experimental-runtime.py",
    "verify:experimental-continuity": "python3 scripts/verify-experimental-continuity.py",
    "verify:experimental-internal-state": "python3 scripts/verify-experimental-internal-state.py"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "jsdom": "26.1.0"
  }
}
