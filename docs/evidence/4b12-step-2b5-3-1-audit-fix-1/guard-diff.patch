+        && host_legacy_time(&done["appliedAt"])
+        && done["sourceSchemaVersion"].as_i64().is_some_and(|v|(1..=CURRENT_SCHEMA).contains(&v))
+        && done["restoredSchemaVersion"].as_i64()==done["sourceSchemaVersion"].as_i64()
+}
